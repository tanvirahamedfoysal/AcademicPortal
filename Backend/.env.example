API_TITLE=Academic Portal API
API_VERSION=1.0.0
API_DESCRIPTION=Backend API for the Academic Portal

# Seeded administrator account
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# PostgreSQL connection used by the async SQLAlchemy engine
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/academic_portal
DATABASE_ECHO=false

# Authentication
SECRET_KEY=change-this-secret-key
INTERNAL_API_KEY=change-this-internal-api-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
DEFAULT_PROFILE_IMAGE_URL=https://placehold.co/256x256/png

# SMTP/Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-username
SMTP_PASSWORD=your-brevo-smtp-password
MAIL_FROM=admin@example.com

DEBUG=true